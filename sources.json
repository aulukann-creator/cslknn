   "items": "[*]",
   "title": "title.rendered | unescape | text",
   "url": "_links.self[0].href",
   "poster": "featured_image",
   "year": "date | year",
   "pageSize": 24
  },
  "search": {
   "url": "https://plus.nasa.gov/wp-json/wp/v2/video?search={query}&per_page=24&page={page}",
   "test": "Europa"
  },
  "detail": {
   "mode": "json",
   "title": "title.rendered | unescape | text",
   "plot": "excerpt.rendered | text || content.rendered | text",
   "poster": "featured_image",
   "background": "featured_image",
   "year": "date | year",
   "duration": "meta.runtime | sec2min",
   "rating": "meta.rating",
   "kind": "'documentary'",
   "data": "meta.video-url || meta.youtube-url"
  },
  "links": {
   "mode": "direct",
